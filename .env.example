# Copiar a .env e iniciar con: node --env-file=.env server/index.js
PORT=3000
# Obligatorio para acceso al personal en producción. Usar una cadena aleatoria larga.
STAFF_TOKEN=
# Opcional: Checkout Pro. Usar credenciales de prueba en desarrollo.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL HTTPS pública del negocio, sin barra final.
PUBLIC_URL=
