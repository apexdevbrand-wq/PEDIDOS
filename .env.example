PORT=3000
SERVE_BUILD=1
# Solo al crear la primera cuenta. Nunca publiques este archivo con contraseñas.
OWNER_USERNAME=dueno
OWNER_PASSWORD=
# Opcional: primera cuenta de cocina. Después usa Administración → Equipo.
STAFF_USERNAME=cocina
STAFF_PASSWORD=
# Compatibilidad con la versión anterior: se usan como contraseñas iniciales
# si OWNER_PASSWORD / STAFF_PASSWORD están vacíos. No cambian cuentas existentes.
OWNER_TOKEN=
STAFF_TOKEN=
# Opcionales: Mercado Pago y despliegue HTTPS.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_URL=
# Contacto real para el protocolo Web Push. Nunca una contraseña.
VAPID_SUBJECT=mailto:pedidos@example.com
# Para docker-compose con HTTPS. Configura tu dominio apuntando al servidor.
DOMAIN=
