# Copiar a .env e iniciar con: node --env-file=.env server/index.js
PORT=3000
# Claves distintas y aleatorias (mínimo recomendado: 32 bytes).
# STAFF_TOKEN: solo cocina. OWNER_TOKEN: cocina y administración.
# Sin claves no se permite acceso de personal, tampoco en desarrollo.
STAFF_TOKEN=
OWNER_TOKEN=
# Opcional: Checkout Pro. Usar credenciales de prueba en desarrollo.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL HTTPS pública del negocio, sin barra final.
PUBLIC_URL=
