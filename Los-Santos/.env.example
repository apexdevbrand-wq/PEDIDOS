PORT=3000
SERVE_BUILD=1
# Solo al crear la primera cuenta. Nunca publiques este archivo con contraseñas.
OWNER_USERNAME=dueno
OWNER_PASSWORD=
# Opcional: primera cuenta de cocina. Después usa Administración → Equipo.
STAFF_USERNAME=cocina
STAFF_PASSWORD=
# Compatibilidad con la versión anterior: se usan como contraseñas iniciales
# si OWNER_PASSWORD / STAFF_PASSWORD están vacíos. No cambian cuentas existentes.
OWNER_TOKEN=
STAFF_TOKEN=

# ── Publicación (ver docs/DEPLOYMENT.md) ──
# Dirección pública con HTTPS, sin diagonal final. Ej. https://lossantos.duckdns.org
PUBLIC_URL=
# Dominio para Caddy (sin https://). Ej. lossantos.duckdns.org
DOMAIN=
# 1 detrás de Caddy (compose por defecto); "cloudflare" con Cloudflare Tunnel.
TRUST_PROXY=1
# Solo si usas Cloudflare Tunnel (perfil "tunnel" de compose.yaml).
CLOUDFLARE_TUNNEL_TOKEN=

# ── Mercado Pago (Checkout Pro) ──
# Primero credenciales de PRUEBA (TEST-...), luego las de producción (APP_USR-...).
MP_ACCESS_TOKEN=
# Clave secreta de la sección Webhooks de tu aplicación en Mercado Pago.
MP_WEBHOOK_SECRET=

# Contacto real para el protocolo Web Push. Nunca una contraseña.
VAPID_SUBJECT=mailto:pedidos@example.com

# ── Respaldos fuera del servidor (S3 compatible: Cloudflare R2 o Backblaze B2) ──
# R2: https://<ID_DE_CUENTA>.r2.cloudflarestorage.com  · región "auto"
# B2: https://s3.<region>.backblazeb2.com               · región p. ej. us-west-004
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=los-santos/
