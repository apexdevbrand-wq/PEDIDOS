// Despliegue en Cloudflare (plan gratis). Ver CLOUDFLARE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "los-santos",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/uploads/*", "/personal", "/personal/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TIENDA", "class_name": "Tienda" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tienda"] }],
  "vars": {
    "VAPID_SUBJECT": "https://www.facebook.com/profile.php?id=61582954447251"
  },
  "observability": { "enabled": true }
}
